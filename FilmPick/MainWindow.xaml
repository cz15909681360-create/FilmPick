<Window x:Class="FilmPick.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FilmPick"
    Title="FilmPick · 选片查看器" Width="1230" Height="796" MinWidth="1010" MinHeight="650"
    Background="{StaticResource Panel}" Foreground="{StaticResource Ink}" FontSize="13" FontFamily="Segoe UI, Microsoft YaHei UI"
    Icon="FilmPick.ico" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKey" PreviewKeyUp="OnKeyUp"
    Deactivated="CancelTransportInput" Closing="OnClosing" Closed="OnClosed"
    AllowDrop="True" PreviewDragEnter="PreviewFileDrag" PreviewDragOver="PreviewFileDrag" PreviewDrop="DropFiles">
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{StaticResource Selected}" CornerRadius="7" Margin="0,0,11,0">
                        <Path Data="M 2,2 L 8,2 M 2,2 L 2,8 M 18,2 L 12,2 M 18,2 L 18,8 M 2,18 L 2,12 M 2,18 L 8,18 M 18,18 L 18,12 M 18,18 L 12,18 M 8,7 L 14,10 L 8,13 Z"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="FilmPick" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Quiet}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenButton" Content="打开素材文件夹" Click="ChooseFolder" Margin="0,0,8,0"/>
                    <Button x:Name="ArchiveButton" Content="预览归档" Click="ReviewArchive" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="LibraryButton" Content="LUT 库" Click="ToggleLibrary" AutomationProperties.Name="打开或收起 LUT 库" Margin="0,0,8,0"/>
                    <Button Content="设置" Click="OpenUiSettings"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="Workspace" Grid.Row="1" Margin="14,13,14,10" SizeChanged="WorkspaceResized">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QueueColumn" Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="422"/>
                <ColumnDefinition x:Name="LibraryGutter" Width="0"/>
                <ColumnDefinition x:Name="LibraryColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
                <Grid Margin="11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="01  /  素材队列" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FolderLabel" Text="未打开文件夹" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,6"/>
                        <CheckBox x:Name="RecursiveBox" Content="包含子文件夹" Click="ChangeRecursion" IsEnabled="False"/>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,13,0,8">
                        <Button x:Name="PhotoTab" Content="照片" Click="PhotoMode" Margin="0,0,4,0"/>
                        <Button x:Name="VideoTab" Content="视频" Click="VideoMode" Margin="4,0,0,0"/>
                    </UniformGrid>
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <Grid>
                            <TextBox x:Name="NameFilter" TextChanged="SearchQueue" Padding="7,5,30,5" ToolTip="按文件名搜索"
                                     AutomationProperties.Name="按文件名搜索"/>
                            <TextBlock Text="搜索文件名" Foreground="{StaticResource Quiet}" FontSize="12" Margin="8,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NameFilter}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="ClearFiltersButton" Content="×" Padding="5,1" Margin="0,2,3,2"
                                    HorizontalAlignment="Right" Visibility="Collapsed" Click="ClearNameSearch"
                                    ToolTip="清除全部筛选" AutomationProperties.Name="清除全部筛选"/>
                        </Grid>
                        <DockPanel Margin="0,6,0,0">
                            <Button x:Name="FilterButton" DockPanel.Dock="Right" Content="筛选" Padding="7,3" Margin="4,0,0,0"
                                    Click="OpenQueueFilters"/>
                            <Button x:Name="OrderDirection" DockPanel.Dock="Right" Content="↑" Padding="6,3" Margin="4,0,0,0"
                                    Click="ReverseOrder" AutomationProperties.Name="反转排序"/>
                            <ComboBox x:Name="OrderField" SelectedIndex="0" SelectionChanged="ChangeOrder" AutomationProperties.Name="排序字段">
                                <ComboBoxItem Content="名称"/>
                                <ComboBoxItem Content="拍摄日期"/>
                                <ComboBoxItem Content="星级"/>
                                <ComboBoxItem Content="选片标记"/>
                            </ComboBox>
                        </DockPanel>
                        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                    CornerRadius="6" Padding="12" Width="282">
                                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                                    <TextBlock Text="拍摄日期" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="DateMode" SelectedIndex="0" SelectionChanged="FilterDateModeChanged" AutomationProperties.Name="拍摄日期筛选">
                                        <ComboBoxItem Content="全部"/>
                                        <ComboBoxItem Content="日期区间"/>
                                        <ComboBoxItem Content="拍摄日期未知"/>
                                    </ComboBox>
                                    <Grid x:Name="DateBounds" Margin="0,5,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <DatePicker x:Name="DateFrom" AutomationProperties.Name="起始日期"/>
                                        <TextBlock Grid.Column="1" Text="至" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <DatePicker x:Name="DateTo" Grid.Column="2" AutomationProperties.Name="结束日期"/>
                                    </Grid>
                                    <TextBlock Text="星级" Margin="0,10,0,4"/>
                                    <UniformGrid Columns="3" x:Name="StarFilters">
                                        <CheckBox Content="未评分"/><CheckBox Content="1 星"/><CheckBox Content="2 星"/>
                                        <CheckBox Content="3 星"/><CheckBox Content="4 星"/><CheckBox Content="5 星"/>
                                    </UniformGrid>
                                    <TextBlock Text="选片标记" Margin="0,10,0,4"/>
                                    <UniformGrid Columns="3" x:Name="MarkFilters">
                                        <CheckBox Content="未标记"/><CheckBox Content="已选"/><CheckBox Content="已排除"/>
                                    </UniformGrid>
                                    <TextBlock x:Name="FilterError" Foreground="{StaticResource Reject}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button Content="应用" DockPanel.Dock="Right" Click="ApplyQueueFilters" Style="{StaticResource Primary}"/>
                                        <Button Content="清除全部筛选" Click="ClearQueueFilters" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button x:Name="QueueTextButton" Content="文字列表" Click="ShowTextQueue" Margin="0,0,2,0" Padding="4,3"/>
                            <Button x:Name="QueueGridButton" Content="缩略图" Click="ShowThumbnailQueue" Margin="2,0,0,0" Padding="4,3"/>
                        </UniformGrid>
                        <TextBlock x:Name="Totals" Text="队列为空" Foreground="{StaticResource Quiet}" Margin="1,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox Grid.Row="3" x:Name="Queue" SelectionChanged="SelectRow" AutomationProperties.Name="素材列表"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.Resources>
                            <ItemsPanelTemplate x:Key="ThumbnailGridItems">
                                <local:ThumbnailGrid ClipToBounds="True"
                                    ImageHeightRatio="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=0.666667}"/>
                            </ItemsPanelTemplate>
                            <Style x:Key="ThumbnailItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                            <DataTemplate x:Key="ThumbnailCard">
                                <Grid ToolTip="{Binding Relative}" AutomationProperties.Name="{Binding Name}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource Panel}" CornerRadius="3" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="暂无预览" Foreground="{StaticResource Quiet}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                                        </Grid>
                                    </Border>
                                    <DockPanel Grid.Row="1" Margin="0,2,0,0">
                                        <StackPanel DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Stars}" Foreground="{StaticResource Accent}" FontSize="11" TextAlignment="Right" Margin="3,0,0,0"/>
                                            <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeColor}" FontSize="11" TextAlignment="Right" Margin="3,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   FontSize="12" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Relative}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="{StaticResource Quiet}" Width="35" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Stars}" Foreground="{StaticResource Accent}" FontSize="11" Margin="4,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Badge}" Foreground="{Binding BadgeColor}" FontSize="11" Margin="5,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <CheckBox x:Name="AutoBox" Content="标记后自动跳到下一条" Click="ChangeAuto" IsChecked="True"/>
                        <TextBlock x:Name="PickTotals" Text="已选 0   ·   已排除 0" Foreground="{StaticResource Quiet}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="160"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition x:Name="BottomRow" Height="52"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="PreviewHeader" Margin="12,0" MinHeight="55">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="PreviewIdentity" MinHeight="43" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock x:Name="MediaName" Text="预览" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <DockPanel>
                                <Button x:Name="RetrySoftwareButton" DockPanel.Dock="Right" Content="软解重试" Visibility="Collapsed"
                                        Click="RetrySoftwareClick" Padding="5,0" Margin="6,0,0,0" FontSize="11"
                                        ToolTip="从当前播放位置使用软件解码重新打开视频"/>
                                <TextBlock x:Name="MediaInfo" Text="照片 / 视频" Foreground="{StaticResource Quiet}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="PreviewToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel x:Name="RatingStrip" Orientation="Horizontal" Margin="0,0,5,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Padding" Value="2,5"/>
                                        <Setter Property="MinWidth" Value="17"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <EventSetter Event="Click" Handler="ClickRating"/>
                                    </Style>
                                </StackPanel.Resources>
                                <Button Tag="1" Content="☆" ToolTip="1 星 · Ctrl+1" AutomationProperties.Name="设为 1 星"/>
                                <Button Tag="2" Content="☆" ToolTip="2 星 · Ctrl+2" AutomationProperties.Name="设为 2 星"/>
                                <Button Tag="3" Content="☆" ToolTip="3 星 · Ctrl+3" AutomationProperties.Name="设为 3 星"/>
                                <Button Tag="4" Content="☆" ToolTip="4 星 · Ctrl+4" AutomationProperties.Name="设为 4 星"/>
                                <Button Tag="5" Content="☆" ToolTip="5 星 · Ctrl+5" AutomationProperties.Name="设为 5 星"/>
                                <Button Tag="0" Content="×" ToolTip="清除评分 · Ctrl+0" AutomationProperties.Name="清除星级"/>
                            </StackPanel>
                            <TextBlock x:Name="GradeLocation" FontSize="10" Foreground="{StaticResource Quiet}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="72" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="CaptureButton" Content="参数 · Tab" Click="ToggleCaptureButton" Padding="7,5" Margin="0,0,5,0"
                                    AutomationProperties.Name="显示或隐藏拍摄参数"/>
                            <Button x:Name="LutToggle" Content="LUT 预览  ·  L" Click="ToggleLutButton" Padding="9,5" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="Viewport" Grid.Row="1" Background="#070A0E" ClipToBounds="True" Margin="1,0">
                        <Image x:Name="Photo" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                        <Border x:Name="PhotoCapture" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                                IsHitTestVisible="False" Background="#A8000000" CornerRadius="3" Padding="6,4">
                            <TextBlock x:Name="PhotoCaptureText" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                        <Grid x:Name="VideoSlot" Visibility="Collapsed"/>
                        <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="510">
                            <TextBlock x:Name="PreviewTitle" Text="打开文件夹，开始选片" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewHint" Text="拖入素材或文件夹，也可以使用「打开素材文件夹」。" Foreground="{StaticResource Quiet}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="16,9"/>
                            <Button x:Name="SwitchEmptyMode" Visibility="Collapsed" HorizontalAlignment="Center" Click="JumpEmptyMode"/>
                        </StackPanel>
                    </Grid>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                                  Background="{StaticResource Edge}" DragCompleted="SaveLayoutDrag" AutomationProperties.Name="调整底部高度"/>
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="VideoControls" Height="38" Margin="12,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Click="PlayButtonClick" Content="播放" Padding="9,2" VerticalAlignment="Center" Margin="0,0,9,0" IsEnabled="False"/>
                        <Slider x:Name="Timeline" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False" Maximum="1"
                                IsMoveToPointEnabled="True" ValueChanged="SeekTime" AutomationProperties.Name="视频进度"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeText" Text="0:00 / 0:00" Foreground="{StaticResource Quiet}" Margin="10,0"/>
                            <Button x:Name="SoundButton" Content="静音" Click="Sound" Padding="8,2" Margin="0,0,6,0" IsEnabled="False"/>
                            <Button x:Name="SpeedButton" Content="1×" Click="ToggleSpeedClick" Padding="7,2" Margin="0,0,3,0"/>
                            <Button x:Name="SpeedMenuButton" Content="⌄" Click="OpenSpeedMenu" Padding="6,2" Margin="0,0,6,0"
                                    AutomationProperties.Name="选择倍速档"/>
                            <Button x:Name="ProxyButton" Content="切代理 · V" Click="ProxyClick" Padding="8,2" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousButton" Content="↑" ToolTip="上一条" Click="Previous" Margin="0,0,5,0" Padding="9,5"/>
                                <Button x:Name="NextButton" Content="↓" ToolTip="下一条" Click="Next" Padding="9,5"/>
                            </StackPanel>
                            <Button x:Name="AttachmentButton" Grid.Column="1" Content="附属文件" Click="EditAttachments" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="8,0,0,0" Padding="9,5" IsEnabled="False"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="UnmarkButton" Content="1 清除" Click="UnmarkClick" Padding="9,5" Margin="0,0,5,0" IsEnabled="False"/>
                                <Button x:Name="RejectButton" Content="2 排除" Click="RejectClick" Foreground="{StaticResource Reject}"
                                        Padding="9,5" Margin="0,0,5,0" IsEnabled="False"/>
                                <Button x:Name="PickButton" Content="3 选中" Click="PickClick" Style="{StaticResource Primary}" Padding="9,5" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="{StaticResource Edge}"
                          DragCompleted="SaveLayoutDrag" AutomationProperties.Name="调整素材队列宽度"/>
            <GridSplitter x:Name="LutSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="{StaticResource Edge}"
                          Visibility="Collapsed" DragCompleted="SaveLayoutDrag" AutomationProperties.Name="调整 LUT 库宽度"/>
            <Border x:Name="LibraryPanel" Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}"
                    BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="×" Click="ToggleLibrary" DockPanel.Dock="Right" Padding="8,1" AutomationProperties.Name="收起 LUT 库"/>
                        <StackPanel>
                            <TextBlock Text="02  /  色彩预设" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                            <TextBlock Text="LUT 库" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DockPanel>
                    <UniformGrid x:Name="LibraryCommands" Grid.Row="1" Columns="2" Margin="0,0,0,8">
                        <Button Content="＋ 导入" Click="ImportLuts" Style="{StaticResource Primary}" Margin="0,0,3,0"/>
                        <Button Content="临时试用" Click="TryLut" Margin="3,0,0,0"/>
                    </UniformGrid>
                    <Border x:Name="TrialBanner" Grid.Row="2" Background="{StaticResource Selected}" Padding="7" CornerRadius="5" Visibility="Collapsed" Margin="0,0,0,8">
                        <DockPanel>
                            <Button Content="保存到库" DockPanel.Dock="Right" Click="SaveTrial" Padding="6,2"/>
                            <TextBlock x:Name="TrialName" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="LutSearch" Grid.Row="3" TextChanged="FilterChanged" ToolTip="搜索 LUT 名称或标签"
                             AutomationProperties.Name="搜索 LUT 名称或标签"/>
                    <DockPanel Grid.Row="4" Margin="0,7">
                        <Button x:Name="FilterTagsButton" Content="筛选标签" Click="ChooseTagFilter" DockPanel.Dock="Right" Padding="7,3"/>
                        <CheckBox x:Name="OnlyFavorites" Content="仅收藏" Click="FilterChanged"/>
                    </DockPanel>
                    <TextBlock x:Name="LibraryStatus" Grid.Row="5" Text="搜索名称或标签" Foreground="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ListBox x:Name="LutCards" Grid.Row="6" Background="{StaticResource Surface}" AutomationProperties.Name="LUT 预设"
                             SelectionChanged="SelectLutCard" MouseLeftButtonUp="LutCardClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Panel}" Width="68" Height="42" CornerRadius="4" HorizontalAlignment="Left">
                                        <Image Loaded="LoadLutCardImage" DataContextChanged="LutCardImageChanged" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TagLine}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Quiet}" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding Star}" Click="FavoriteLut" Foreground="{StaticResource Accent}" Padding="5,2"
                                            VerticalAlignment="Center" ToolTip="切换收藏" AutomationProperties.Name="切换收藏"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <UniformGrid x:Name="LibraryActions" Grid.Row="7" Columns="3" Rows="2" Margin="0,8,0,0">
                        <Button x:Name="EditLutButton" Content="编辑" Click="EditLut" Margin="0,0,3,4" Padding="4,4"/>
                        <Button x:Name="RemoveLutButton" Content="移除" Click="RemoveLut" Margin="3,0,3,4" Padding="4,4"/>
                        <Button Content="标签" Click="ManageTags" Margin="3,0,0,4" Padding="4,4"/>
                        <Button Content="导出 ZIP" Click="ExportLibrary" Margin="0,0,3,0" Padding="4,4"/>
                        <Button Content="合并 ZIP" Click="RestoreLibrary" Margin="3,0,3,0" Padding="4,4"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLine" Text="确认后只复制 · 原件不动" Foreground="{StaticResource Quiet}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="GradeStatus" Click="ReviewGradeWrites" Visibility="Collapsed" Padding="9,3" Margin="6,0,0,0"/>
                    <Button x:Name="RecoveryButton" Content="恢复未完成的归档" Click="RecoverArchive"
                            Visibility="Collapsed" Padding="9,3" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
